# ============================================================================
# STAGE 1: Builder - Instalar dependencias que requieren compilación
# ============================================================================
FROM python:3.11-slim as builder

WORKDIR /app

# Instalar herramientas de compilación (solo para build)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar dependencias
COPY requirements-api.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --user -r requirements-api.txt

# ============================================================================
# STAGE 2: Runtime - Imagen final ligera
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

# Copiar solo las dependencias instaladas desde el builder
COPY --from=builder /root/.local /root/.local

# Asegurar que los scripts en .local sean usables
ENV PATH=/root/.local/bin:$PATH

# Copiar solo lo necesario para la API
COPY src/api/ ./src/api/
COPY src/models/ ./src/models/

# Variables de entorno
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
