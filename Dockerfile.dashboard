# ============================================================================
# STAGE 1: Builder - Instalar dependencias
# ============================================================================
FROM python:3.11-slim as builder

WORKDIR /app

# Copiar e instalar dependencias
COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --user -r requirements-dashboard.txt

# ============================================================================
# STAGE 2: Runtime - Imagen final ligera
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

# Copiar solo las dependencias instaladas desde el builder
COPY --from=builder /root/.local /root/.local

# Asegurar que los scripts en .local sean usables
ENV PATH=/root/.local/bin:$PATH

# Copiar solo el código del dashboard
COPY src/dashboard/ ./src/dashboard/

# Variables de entorno
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    #API_URL=http://api:8000

EXPOSE 8501

#CMD ["streamlit", "run", "src/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
CMD streamlit run src/dashboard/app.py --server.port=${PORT:-8501} --server.address=0.0.0.0 --server.enableCORS=false --server.enableXsrfProtection=false